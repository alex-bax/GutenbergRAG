local.file_match "fastapi_logs" {
  path_targets = [
    {
      __path__ = sys.env("ALLOY_LOG_PATH")
      service  = sys.env("ALLOY_SERVICE_NAME")
      env      = sys.env("ALLOY_ENVIRONMENT")
      source   = "fastapi-webapp"
    },
  ]
}

loki.source.file "fastapi" {
  targets    = local.file_match.fastapi_logs.targets
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = sys.env("LOKI_PUSH_URL")
  }

  external_labels = {
    job         = "webapp-logs",
    environment = sys.env("ALLOY_ENVIRONMENT"),
  }
}
